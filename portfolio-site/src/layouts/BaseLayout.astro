---
import { Font } from 'astro:assets';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const {
  title = site.siteTitle,
  description = site.description,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <Font cssVariable="--font-lora" preload />
    <Font cssVariable="--font-open-sans" preload />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* JSON-LD is a data block, not executable script, so CSP script-src
         does not apply to it. Deliberately omits the phone number. */
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    {/* Phase 4 (Ernest): breadcrumb (b) mounts here --
       <script src="/hello.js" defer is:inline></script>
       Kept out until the file exists so Phase 1 ships zero JS. */}
  </head>

  <body class="bg-[--color-paper] text-[--color-ink]">
    <slot />
  </body>
</html>
